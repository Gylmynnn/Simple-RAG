OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=google/gemini-2.5-flash-preview:free
SCRAPE_URLS=https://en.wikipedia.org/wiki/Retrieval-augmented_generation,https://en.wikipedia.org/wiki/Artificial_intelligence
SCRAPE_TIMEOUT_SECONDS=15
SCRAPE_CHUNK_SIZE=800
SCRAPE_CHUNK_OVERLAP=120
SCRAPE_MIN_TEXT_LENGTH=250
SCRAPE_FOLLOW_LINKS=true
SCRAPE_MAX_LINKS_PER_URL=6
SCRAPE_MAX_TOTAL_URLS=40
RETRIEVER_TOP_K=6
RETRIEVER_CANDIDATE_MULTIPLIER=5
RETRIEVER_LEXICAL_WEIGHT=0.2
RETRIEVER_MAX_PER_SOURCE=3
MAX_CONTEXT_CHARS=12000
NEWS_MAX_STORIES=8
SHOW_RETRIEVED_CONTEXT=false
